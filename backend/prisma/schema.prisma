generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@schema("public")
}

model User {
  id                   Int                 @id @default(autoincrement())
  email                String              @unique
  password             String
  name                 String
  roleId               Int
  status               String              @default("APPROVED")
  locked               Boolean             @default(false)
  pin                  String?
  defaultCheckIn       String?   @default("09:00")
  monthlySalary        Float     @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  staffProfileId       String?             @unique @db.Uuid
  authUserId           String?             @unique @db.Uuid
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  amcRequests          AMCPaymentRequest[]
  processedUnenrollments UnenrollmentRequest[]
  announcements        Announcement[]
  payments             Payment[]
  systemLocks          SystemStatus[]
  role                 Role                @relation(fields: [roleId], references: [id])
  staffProfile         staff?              @relation(fields: [staffProfileId], references: [id])
  leaveApplications      StaffLeave[]               @relation("StaffLeave_user")
  reviewedLeaves         StaffLeave[]               @relation("StaffLeave_reviewer")
  leaveBalances          LeaveBalance[]
  housekeepingAllocations HousekeepingAllocation[]
  housekeepingInstances   HousekeepingTaskInstance[]
  screenAccess            UserScreenAccess[]
  attendanceRecords       StaffAttendance[]
  salaryRecords           StaffSalary[]
  exportRequests          ExportRequest[]

  @@schema("public")
}

model Member {
  id                     Int                 @id @default(autoincrement())
  membershipNumber       String              @unique
  category               String
  tenure                 String
  nameAsAadhaar          String
  fatherHusbandName      String
  gender                 String
  dob                    DateTime
  maritalStatus          String
  occupation             String
  companyName            String?
  designation            String?
  aadhaarNumber          String              @unique
  panNumber              String?
  gstNumber              String?
  mobileNumber           String              @unique
  alternateMobile        String?
  whatsappNumber         String?
  email                  String?             @unique
  residentialAddress     String
  officeAddress          String?
  city                   String
  state                  String
  pincode                String
  nationality            String
  bloodGroup             String
  emergencyContactName   String
  emergencyContactNumber String
  referenceName          String?
  salesExecutiveName     String?
  photoUrl               String?
  signatureUrl           String?
  offerPrice             Float
  membershipFee          Float
  registrationFee        Float
  discountAmount         Float
  netAmount              Float
  gstAmount              Float
  totalAmount            Float
  paymentMode            String
  paymentRef             String?
  receiptNumber          String?
  bookingDate            DateTime            @default(now())
  startDate              DateTime
  expiryDate             DateTime
  amcApplicable          Boolean             @default(true)
  amcAmount              Float               @default(5000)
  status                 String              @default("PENDING")
  amcStatus              String              @default("UNPAID")
  accessStatus           String              @default("DISABLED")
  isActive               Boolean             @default(true)
  isBlacklisted          Boolean             @default(false)
  lastLogin              DateTime?
  lastAccess             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  password               String?
  amcYear                String?
  ledgerBalance          Float               @default(0)
  validityType           String              @default("5_YEAR")
  authUserId             String?             @unique @db.Uuid
  paymentProofUrl        String?
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?
  amcRequests            AMCPaymentRequest[]
  accessLogs             AccessLog[]
  complaints             Complaint[]
  familyMembers          FamilyMember[]
  feedbacks              Feedback[]
  invoices               Invoice[]
  restaurantOrders       Order[]
  reservations           Reservation[]
  tableReservations      TableReservation[]
  unenrollmentRequests   UnenrollmentRequest[]

  @@schema("public")
}

model TableReservation {
  id         Int      @id @default(autoincrement())
  memberId   Int
  affiliateId Int?
  date       DateTime
  time       String
  paxCount   Int
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  member     Member   @relation(fields: [memberId], references: [id])
  affiliate  FamilyMember? @relation(fields: [affiliateId], references: [id])

  @@schema("public")
}

model UnenrollmentRequest {
  id              Int       @id @default(autoincrement())
  memberId        Int
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  processedById   Int?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id])
  processedBy     User?     @relation(fields: [processedById], references: [id])

  @@schema("public")
}

model AMCPaymentRequest {
  id              Int       @id @default(autoincrement())
  memberId        Int
  amount          Float
  transactionRef  String?
  paymentDate     DateTime
  proofUrl        String?
  status          String    @default("PENDING")
  rejectionReason String?
  processedById   Int?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id])
  processedBy     User?     @relation(fields: [processedById], references: [id])

  @@schema("public")
}

model Activity {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  location     String
  capacity     Int
  startTime    DateTime
  endTime      DateTime
  category     String
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  status       String        @default("UPCOMING")
  timer        DateTime?
  reservations Reservation[]

  @@schema("public")
}

model Reservation {
  id         Int      @id @default(autoincrement())
  memberId   Int
  affiliateId Int?
  activityId Int
  paxCount   Int      @default(1)
  status     String   @default("CONFIRMED")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  member     Member   @relation(fields: [memberId], references: [id])
  affiliate  FamilyMember? @relation(fields: [affiliateId], references: [id])

  @@schema("public")
}

model FamilyMember {
  id                Int      @id @default(autoincrement())
  memberId          Int
  membershipNumber  String?  @unique
  name              String
  relation          String
  dob               DateTime
  gender            String
  mobileNumber      String?  @unique
  email             String?  @unique
  aadhaarNumber     String?
  photoUrl          String?
  biometricId       String?
  qrCode            String?
  accessPermissions String?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  password          String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  member            Member   @relation(fields: [memberId], references: [id])
  reservations      Reservation[]
  tableReservations TableReservation[]
  restaurantOrders  Order[]
  complaints        Complaint[]
  feedbacks         Feedback[]
  accessLogs        AccessLog[]

  @@schema("public")
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  memberId           Int?
  department         String
  amount             Float
  discount           Float         @default(0)
  gst                Float
  roundOff           Float         @default(0)
  total              Float
  status             String        @default("UNPAID")
  dueDate            DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancellationStatus String?
  member             Member?       @relation(fields: [memberId], references: [id])
  walkInGuestId      Int?
  walkInGuest        WalkInGuest?  @relation(fields: [walkInGuestId], references: [id])
  items              InvoiceItem[]
  payments           Payment[]

  @@schema("public")
}

model WalkInGuest {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@schema("public")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@schema("public")
}

model Payment {
  id              Int      @id @default(autoincrement())
  receiptNumber   String   @unique
  invoiceId       Int
  amount          Float
  paymentMode     String
  referenceNumber String?
  paymentDate     DateTime @default(now())
  receivedById    Int?
  transactionId   String?
  proofUrl        String?
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  receivedBy      User?    @relation(fields: [receivedById], references: [id])

  @@schema("public")
}

model RestaurantTable {
  id       Int     @id @default(autoincrement())
  number   String  @unique
  capacity Int
  status   String  @default("AVAILABLE")
  floor    String  @default("Main Floor")
  orders   Order[]

  @@schema("public")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  category    String
  price       Float
  department  String      @default("RESTAURANT")
  isAvailable Boolean     @default(true)
  orderItems  OrderItem[]
  recipes     Recipe[]

  @@schema("public")
}

model InventoryItem {
  id              Int            @id @default(autoincrement())
  name            String
  category        String
  unit            String
  currentStock    Float          @default(0)
  minStockLevel   Float          @default(5)
  unitPrice       Float          @default(0)
  lastRestockedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  logs            InventoryLog[]
  recipes         Recipe[]

  @@schema("public")
}

model InventoryLog {
  id            Int           @id @default(autoincrement())
  itemId        Int
  change        Float
  type          String
  description   String?
  performedById Int
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@schema("public")
}

model Recipe {
  id              Int           @id @default(autoincrement())
  menuItemId      Int
  inventoryItemId Int
  quantity        Float
  exactWeight     Float?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
  @@schema("public")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  memberId   Int?
  affiliateId Int?
  memberName String?
  rating     Int
  comments   String?
  department String   @default("RESTAURANT")
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  member     Member?  @relation(fields: [memberId], references: [id])
  affiliate  FamilyMember? @relation(fields: [affiliateId], references: [id])

  @@schema("public")
}

model Order {
  id          Int             @id @default(autoincrement())
  orderNumber String          @unique
  tableId     Int
  memberId    Int?
  affiliateId Int?
  paxCount    Int             @default(1)
  status      String          @default("OPEN")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isPrepaid   Boolean         @default(false)
  isVerified  Boolean         @default(true)
  member      Member?         @relation(fields: [memberId], references: [id])
  affiliate   FamilyMember?   @relation(fields: [affiliateId], references: [id])
  table       RestaurantTable @relation(fields: [tableId], references: [id])
  items       OrderItem[]

  @@schema("public")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  status     String   @default("PENDING")
  notes      String?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])

  @@schema("public")
}

model AccessLog {
  id             Int      @id @default(autoincrement())
  memberId       Int
  affiliateId    Int?
  deviceIp       String?
  deviceLocation String?
  accessType     String   @default("ENTRY")
  isAllowed      Boolean
  denialReason   String?
  timestamp      DateTime @default(now())
  member         Member   @relation(fields: [memberId], references: [id])
  affiliate      FamilyMember? @relation(fields: [affiliateId], references: [id])

  @@schema("public")
}

model Complaint {
  id          Int       @id @default(autoincrement())
  memberId    Int
  affiliateId Int?
  subject     String
  description String
  category    String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  member      Member    @relation(fields: [memberId], references: [id])
  affiliate   FamilyMember? @relation(fields: [affiliateId], references: [id])
  messages    Message[]

  @@schema("public")
}

model Message {
  id          Int       @id @default(autoincrement())
  complaintId Int
  senderType  String
  senderId    Int
  senderName  String
  content     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])

  @@schema("public")
}

model Announcement {
  id             Int      @id @default(autoincrement())
  title          String
  content        String
  targetAudience String   @default("ALL")
  isActive       Boolean  @default(true)
  createdById    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation(fields: [createdById], references: [id])

  @@schema("public")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entityType  String
  entityId    String?
  description String
  oldData     String?
  newData     String?
  userId      Int
  userName    String
  userRole    String
  createdAt   DateTime @default(now())

  @@schema("public")
}

model Asset {
  id              Int              @id @default(autoincrement())
  name            String
  category        String
  tagNumber       String           @unique
  location        String
  purchaseDate    DateTime
  purchaseCost    Float
  status          String           @default("OPERATIONAL")
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  maintenanceLogs MaintenanceLog[]

  @@schema("public")
}

model MaintenanceLog {
  id          Int      @id @default(autoincrement())
  assetId     Int
  serviceDate DateTime @default(now())
  serviceType String
  performedBy String
  cost        Float    @default(0)
  description String
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset       Asset    @relation(fields: [assetId], references: [id])

  @@schema("public")
}

model SystemStatus {
  id         Int       @id @default(1)
  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockedById Int?
  reason     String?
  lockedBy   User?     @relation(fields: [lockedById], references: [id])

  @@schema("public")
}

