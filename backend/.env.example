# ─── Database (Supabase PostgreSQL) ────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.example.supabase.co:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.example.supabase.co:5432/postgres"

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET="your-secret-key-change-in-production"

# ─── Server ─────────────────────────────────────────────────
PORT=5001
FRONTEND_URL=http://localhost:3000          # Comma-separated for multiple origins

# ─── SMTP (Email) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=office@example.com
SMTP_PASS=your-app-password
SMTP_SECURE=true

# ─── WhatsApp Cloud API (Meta) ──────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0

# ─── Expo Push ──────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
